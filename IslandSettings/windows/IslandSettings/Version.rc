#include <winres.h>
#include "ReleaseVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ISLAND_VERSION_NUMBERS
 PRODUCTVERSION ISLAND_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "acheeseburgercodes"
            VALUE "FileDescription", "Windows Dynamic Island Control Center"
            VALUE "FileVersion", ISLAND_VERSION_STRING
            VALUE "InternalName", "IslandSettings"
            VALUE "LegalCopyright", "Copyright (c) 2026 acheeseburgercodes"
            VALUE "OriginalFilename", "IslandSettings.exe"
            VALUE "ProductName", "Windows Dynamic Island"
            VALUE "ProductVersion", ISLAND_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
