<Window
    x:Class="DynamicIsland.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dynamic Island">

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="IslandSurface"
                Margin="4"
                Padding="10,6"
                Background="{StaticResource IslandSurfaceBrush}"
                CornerRadius="22"
                PointerEntered="Island_PointerEntered"
                PointerExited="Island_PointerExited"
                PointerPressed="Island_PointerPressed">
            <Grid>
                <Grid x:Name="CollapsedContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="28" Height="28">
                        <Border Background="#FF27272C" CornerRadius="7" />
                        <Image x:Name="CollapsedArtwork" Stretch="UniformToFill" />
                        <FontIcon x:Name="CollapsedFallbackIcon"
                                  Glyph="&#xE8D6;"
                                  FontSize="13"
                                  Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CollapsedTitle"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Dynamic Island"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CollapsedArtist"
                                   FontSize="9"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Hover to open"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <FontIcon Grid.Column="2"
                              Glyph="&#xE70D;"
                              FontSize="10"
                              Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>

                <Grid x:Name="ExpandedContent" Opacity="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="4">
                        <Border Background="#FF27272C" CornerRadius="18" />
                        <Image x:Name="Artwork" Stretch="UniformToFill" />
                        <FontIcon x:Name="ArtworkFallbackIcon"
                                  Glyph="&#xE8D6;"
                                  FontSize="44"
                                  Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <Grid Grid.Column="1" Margin="22,12,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="NOW PLAYING"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#FF6ED6A9"
                                       CharacterSpacing="120" />
                            <Button HorizontalAlignment="Right"
                                    Width="30" Height="30"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CollapseButton_Click">
                                <FontIcon Glyph="&#xE70E;" FontSize="11" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TrackTitle"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Nothing playing"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TrackArtist"
                                       Margin="0,5,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Start music in any supported app"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AlbumTitle"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#FF717178"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PreviousButton"
                                    Width="44" Height="44"
                                    Padding="0"
                                    Background="{StaticResource ControlSurfaceBrush}"
                                    BorderThickness="0"
                                    CornerRadius="22"
                                    Click="PreviousButton_Click">
                                <FontIcon Glyph="&#xE892;" FontSize="16" />
                            </Button>
                            <Button x:Name="PlayPauseButton"
                                    Width="52" Height="52"
                                    Padding="0"
                                    Background="#FFF4F4F5"
                                    Foreground="#FF111113"
                                    BorderThickness="0"
                                    CornerRadius="26"
                                    Click="PlayPauseButton_Click">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                            </Button>
                            <Button x:Name="NextButton"
                                    Width="44" Height="44"
                                    Padding="0"
                                    Background="{StaticResource ControlSurfaceBrush}"
                                    BorderThickness="0"
                                    CornerRadius="22"
                                    Click="NextButton_Click">
                                <FontIcon Glyph="&#xE893;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
