<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Icon="pack://application:,,,/Assets/island-logo.png"
        Width="72" Height="26"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
    <Border x:Name="IslandSurface"
            Padding="6,4"
            Background="{StaticResource IslandSurfaceBrush}"
            CornerRadius="13"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid x:Name="CollapsedContent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border x:Name="MiniLogoContainer" Width="16" Height="16" Background="{StaticResource PrimaryActionBrush}" CornerRadius="8">
                        <Grid>
                            <Image x:Name="MiniLogoArtwork" Visibility="Collapsed" Stretch="Uniform" />
                            <Path x:Name="MiniLogoGlyph" Data="{StaticResource IconMusic}" Width="10" Height="10"
                                  Fill="{StaticResource PrimaryActionTextBrush}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="MiniLogoText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="DI" FontSize="7" FontWeight="Bold" Foreground="{StaticResource PrimaryActionTextBrush}" />
                        </Grid>
                    </Border>
                    <Ellipse x:Name="PlaybackIndicator" Width="5" Height="5" Margin="6,0,0,0"
                             Fill="#FF717178" />
                </StackPanel>
            </Grid>

            <Grid x:Name="PreviewContent" Visibility="Collapsed" Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewLogoContainer" Width="36" Height="36" Padding="3" VerticalAlignment="Center"
                        Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="10">
                    <Grid>
                        <Image x:Name="PreviewArtwork" Stretch="Uniform" />
                        <Path x:Name="PreviewLogoGlyph" Data="{StaticResource IconMusic}" Width="20" Height="20"
                              Fill="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewFallbackIcon" Text="DI" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewTitle" Text="Dynamic Island" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PreviewArtist" Text="Ready · drag to reposition" Margin="0,2,0,0"
                               FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviewPreviousButton" Style="{StaticResource IslandButton}"
                            Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                            ToolTip="Previous" Click="PreviousButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconPrevious}" Width="13" Height="13" /></Button>
                    <Button x:Name="PreviewPlayPauseButton" Style="{StaticResource IslandButton}"
                            Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                            Background="{StaticResource PrimaryActionBrush}" Foreground="{StaticResource PrimaryActionTextBrush}"
                            ToolTip="Play or pause" Click="PlayPauseButton_Click">
                        <Path x:Name="PreviewPlayPauseIcon" Style="{StaticResource IslandIcon}" Data="{StaticResource IconPlay}" Width="13" Height="13" />
                    </Button>
                    <Button x:Name="PreviewNextButton" Style="{StaticResource IslandButton}"
                            Width="28" Height="28" Padding="0"
                            ToolTip="Next" Click="NextButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconNext}" Width="13" Height="13" /></Button>
                </StackPanel>
                <Button Grid.Column="3" Width="30" Height="30" Padding="0"
                        Style="{StaticResource IslandButton}" ToolTip="Open full island"
                        Click="FullExpandButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconExpand}" Width="14" Height="14" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Button>
            </Grid>

            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/island-logo.png" Width="26" Height="26"
                               Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"
                               ToolTip="Dynamic Island" />
                        <Button Style="{StaticResource IslandButton}" Margin="0,0,5,0" Click="MediaNavButton_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconMusic}" /><TextBlock Text="Media" Margin="6,0,0,0" /></StackPanel></Button>
                        <Button Style="{StaticResource IslandButton}" Margin="0,0,5,0" Click="FilesNavButton_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconFiles}" /><TextBlock Text="Files" Margin="6,0,0,0" /></StackPanel></Button>
                        <Button Style="{StaticResource IslandButton}" Margin="0,0,5,0" Click="ClipboardNavButton_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconClipboard}" /><TextBlock Text="Clipboard" Margin="6,0,0,0" /></StackPanel></Button>
                        <Button Style="{StaticResource IslandButton}" Margin="0,0,5,0" Click="AppsNavButton_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconApps}" /><TextBlock Text="Apps" Margin="6,0,0,0" /></StackPanel></Button>
                        <Button Style="{StaticResource IslandButton}" Click="SettingsNavButton_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconSettings}" /><TextBlock Text="Settings" Margin="6,0,0,0" /></StackPanel></Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IslandButton}" Width="32" Padding="0" Margin="0,0,4,0"
                                Foreground="#FFFF9A9A" ToolTip="Exit" Click="ExitButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconClose}" Width="13" Height="13" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Button>
                        <Button Style="{StaticResource IslandButton}" Width="32" Padding="0"
                                ToolTip="Collapse" Click="CollapseButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconCollapse}" Width="13" Height="13" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid x:Name="MediaPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="142" Height="142" VerticalAlignment="Center" Padding="10"
                                Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="18">
                            <Grid>
                                <Image x:Name="Artwork" Stretch="Uniform" />
                                <Path x:Name="ArtworkFallbackIcon" Data="{StaticResource IconMusic}" Width="52" Height="52"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{StaticResource SecondaryTextBrush}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="18,12,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                <Button x:Name="OpenPlayerButton" Style="{StaticResource IslandButton}"
                                        HorizontalAlignment="Right" Padding="8,5" FontSize="10"
                                        Click="OpenPlayerButton_Click" Content="Open player" />
                            </Grid>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitle" Text="Nothing playing" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackArtist" Text="Start music in a supported app" Margin="0,5,0,0"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AlbumTitle" Margin="0,3,0,0" FontSize="11"
                                           Foreground="#FF717178" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="DurationText" Text="0:00" FontSize="10" HorizontalAlignment="Right"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="SeekSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="0"
                                        IsEnabled="False" Margin="0,5,0,0"
                                        ValueChanged="SeekSlider_ValueChanged"
                                        PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                        PreviewKeyUp="SeekSlider_PreviewKeyUp" />
                            </Grid>
                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button x:Name="PreviousButton" Style="{StaticResource IslandButton}" Width="44" Height="44"
                                        Padding="0" Margin="0,0,10,0" Click="PreviousButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconPrevious}" Width="19" Height="19" /></Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}" Width="52" Height="52"
                                        Padding="0" Margin="0,0,10,0" Background="{StaticResource PrimaryActionBrush}"
                                        Foreground="{StaticResource PrimaryActionTextBrush}"
                                        Click="PlayPauseButton_Click">
                                    <Path x:Name="PlayPauseIcon" Style="{StaticResource IslandIcon}" Data="{StaticResource IconPlay}" Width="21" Height="21" />
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource IslandButton}" Width="44" Height="44"
                                        Padding="0" Click="NextButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconNext}" Width="19" Height="19" /></Button>
                            </StackPanel>
                            <TextBlock x:Name="MediaStatusText" Grid.Row="4" Margin="0,8,0,0" FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>

                    <Grid x:Name="FilesPanel" Visibility="Collapsed" Margin="4,4,4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="74" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="File shelf" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Stored safely in the island until you remove them. Drag items out to use them." FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="FileDockStatus" FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                        Click="OpenFileDockFolderButton_Click" Content="Open stored folder" />
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                        Click="PasteFilesButton_Click" Content="Paste files" />
                                <Button Style="{StaticResource IslandButton}" Background="{StaticResource PrimaryActionBrush}"
                                        Foreground="{StaticResource PrimaryActionTextBrush}"
                                        Click="AddFilesButton_Click" Content="Add files" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,0,0,8" AllowDrop="True"
                                Background="{StaticResource DropSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                CornerRadius="14" DragOver="FilesDropZone_DragOver" Drop="FilesDropZone_Drop">
                            <TextBlock Text="＋  Drop files here" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                        <ListView x:Name="FileList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="FileList_PreviewMouseMove">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="660" Height="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8">
                                            <Path Data="{StaticResource IconFiles}" Width="17" Height="17" Fill="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FullPath}" FontSize="9"
                                                       Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource IslandButton}" Width="32" Padding="0" Margin="0,0,5,0"
                                                    Tag="{Binding FullPath}" ToolTip="Open" Click="OpenFileButton_Click" Content="↗" />
                                            <Button Style="{StaticResource IslandButton}" Width="32" Padding="0" Margin="0,0,5,0"
                                                    Tag="{Binding FullPath}" ToolTip="Copy" Click="CopyFileButton_Click" Content="▣" />
                                            <Button Style="{StaticResource IslandButton}" Width="32" Padding="0" Foreground="#FFFF8A8A"
                                                    Tag="{Binding FullPath}" ToolTip="Remove" Click="RemoveFileButton_Click" Content="×" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="ClipboardPanel" Visibility="Collapsed" Margin="4,4,4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Clipboard" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Paste, edit, and copy text through the Windows clipboard." FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBox x:Name="ClipboardTextBox" Grid.Row="1" Margin="0,12" Padding="12"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource InputSurfaceBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                                 BorderThickness="0" />
                        <Grid Grid.Row="2">
                            <TextBlock x:Name="ClipboardStatus" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                        Click="PasteTextButton_Click" Content="Paste" />
                                <Button Style="{StaticResource IslandButton}" Background="{StaticResource PrimaryActionBrush}"
                                        Foreground="{StaticResource PrimaryActionTextBrush}"
                                        Click="CopyTextButton_Click" Content="Copy" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AppsPanel" Visibility="Collapsed" Margin="4,4,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="225" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <TextBlock Text="App runner" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Desktop apps can be interactive here; packaged apps such as WhatsApp use a live preview. Open externally restores their window."
                                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>

                        <Border Grid.Row="1" Padding="8" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource PrimaryTextBrush}" DisplayMemberPath="Name" />
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IslandButton}" Margin="0,0,6,0"
                                                Click="AddAppButton_Click" Content="Add app" />
                                        <Button Style="{StaticResource IslandButton}" Foreground="#FFFF8A8A"
                                                Click="RemoveAppButton_Click" Content="Remove" />
                                    </StackPanel>
                                    <TextBlock Text="Running windows" Margin="2,10,0,4" FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="RunningAppsComboBox" DisplayMemberPath="DisplayName"
                                              MaxDropDownHeight="180" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource IslandButton}" Margin="0,0,6,0"
                                                Click="RefreshRunningAppsButton_Click" Content="Refresh" />
                                        <Button Style="{StaticResource IslandButton}"
                                                Click="UseRunningAppButton_Click" Content="Use in panel" />
                                    </StackPanel>
                                    <TextBlock Text="Installed applications" Margin="2,10,0,4" FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="InstalledAppsComboBox" DisplayMemberPath="Name"
                                              MaxDropDownHeight="200" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource IslandButton}" Margin="0,0,6,0"
                                                Click="RefreshInstalledAppsButton_Click" Content="Refresh" />
                                        <Button Style="{StaticResource IslandButton}"
                                                Click="RunInstalledAppButton_Click" Content="Run here" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="AppHostViewport" Grid.Row="1" Grid.Column="2"
                                Background="{StaticResource HostSurfaceBrush}" CornerRadius="14" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="AppHostPlaceholder"
                                           Text="Choose an application, then select Use in panel"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="AppRunnerStatus" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                        Click="DetachAppButton_Click" Content="Open externally" />
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                        Click="LaunchAppButton_Click" Content="Open normally" />
                                <Button Style="{StaticResource IslandButton}" Background="{StaticResource PrimaryActionBrush}"
                                        Foreground="{StaticResource PrimaryActionTextBrush}"
                                        Click="UseAppInPanelButton_Click" Content="Use in panel" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,12,8">
                            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="SettingsSaveStatusText" Text="Changes are saved automatically."
                                       FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Island opacity" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="The per-pixel transparent surface." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="OpacityValueText" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Slider x:Name="OpacitySlider" Style="{StaticResource BeUiOpacitySlider}" Minimum="10" Maximum="100" Value="42"
                                                ValueChanged="OpacitySlider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Appearance" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Switch between dark and light island surfaces." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1"
                                              SelectionChanged="ThemeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Dark" />
                                        <ComboBoxItem Content="Light" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Island surface" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Use the theme color or your own two-color gradient."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ComboBox x:Name="SurfaceStyleComboBox"
                                                  SelectionChanged="SurfaceStyleComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Solid theme color" />
                                            <ComboBoxItem Content="Custom gradient" />
                                        </ComboBox>
                                        <StackPanel x:Name="GradientOptions" Margin="0,8,0,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBox x:Name="GradientStartColorTextBox" Width="130" Height="28" Padding="7,3"
                                                         VerticalContentAlignment="Center" Background="{StaticResource InputSurfaceBrush}"
                                                         Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0" />
                                                <Button Style="{StaticResource IslandButton}" Tag="Start" Margin="8,0,0,0"
                                                        Click="PickGradientColorButton_Click" Content="Pick start" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBox x:Name="GradientEndColorTextBox" Width="130" Height="28" Padding="7,3"
                                                         VerticalContentAlignment="Center" Background="{StaticResource InputSurfaceBrush}"
                                                         Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0" />
                                                <Button Style="{StaticResource IslandButton}" Tag="End" Margin="8,0,0,0"
                                                        Click="PickGradientColorButton_Click" Content="Pick end" />
                                            </StackPanel>
                                            <ComboBox x:Name="GradientDirectionComboBox"
                                                      SelectionChanged="GradientDirectionComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Top to bottom" />
                                                <ComboBoxItem Content="Left to right" />
                                                <ComboBoxItem Content="Diagonal" />
                                            </ComboBox>
                                            <Button Style="{StaticResource IslandButton}" Margin="0,7,0,0"
                                                    HorizontalAlignment="Left" Click="ApplyGradientButton_Click" Content="Apply colors" />
                                            <TextBlock x:Name="GradientStatusText" Margin="0,5,0,0" FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Accent color" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Use a hex color or choose a preset." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="AccentStatusText" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="AccentPreview" Width="28" Height="28" Margin="0,0,8,0"
                                                    Background="{DynamicResource AccentBrush}" CornerRadius="8" />
                                            <TextBox x:Name="AccentColorTextBox" Width="104" Height="28" Padding="7,3"
                                                     VerticalContentAlignment="Center" Background="{StaticResource InputSurfaceBrush}"
                                                     Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0" />
                                            <Button Style="{StaticResource IslandButton}" Margin="8,0,0,0" Padding="9,4"
                                                    Click="PickAccentButton_Click" Content="Pick" />
                                            <Button Style="{StaticResource IslandButton}" Margin="8,0,0,0" Padding="10,4"
                                                    Click="ApplyAccentButton_Click" Content="Apply" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource IslandButton}" Tag="#6ED6A9" Padding="8,3" Margin="0,0,5,0"
                                                    Click="AccentPresetButton_Click" Content="Mint" />
                                            <Button Style="{StaticResource IslandButton}" Tag="#66A3FF" Padding="8,3" Margin="0,0,5,0"
                                                    Click="AccentPresetButton_Click" Content="Blue" />
                                            <Button Style="{StaticResource IslandButton}" Tag="#B68CFF" Padding="8,3" Margin="0,0,5,0"
                                                    Click="AccentPresetButton_Click" Content="Purple" />
                                            <Button Style="{StaticResource IslandButton}" Tag="#FF9A62" Padding="8,3"
                                                    Click="AccentPresetButton_Click" Content="Orange" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Island logo" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Choose what appears in the mini and hover states." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LogoStyleComboBox" Grid.Column="1"
                                              SelectionChanged="LogoStyleComboBox_SelectionChanged">
                                        <ComboBoxItem Content="DI monogram" />
                                        <ComboBoxItem Content="Music note" />
                                        <ComboBoxItem Content="Minimal dot" />
                                        <ComboBoxItem Content="Album artwork" />
                                        <ComboBoxItem Content="Island mark" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Custom mini logo" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Crop and rotate a picture for the minimized island. A copy is saved locally."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                                    Click="ChooseMiniLogoButton_Click" Content="Choose picture" />
                                            <Button Style="{StaticResource IslandButton}"
                                                    Click="ClearMiniLogoButton_Click" Content="Clear" />
                                        </StackPanel>
                                        <TextBlock x:Name="MiniLogoStatusText" Margin="0,6,0,0" FontSize="10"
                                                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Dock position" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <Button Style="{StaticResource IslandButton}" Margin="0,8,20,0"
                                                Click="ResetPositionButton_Click" Content="Reset position" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="Edge" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="EdgeComboBox" SelectionChanged="EdgeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Top" /><ComboBoxItem Content="Left" /><ComboBoxItem Content="Right" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Alignment" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="AlignmentComboBox" SelectionChanged="AlignmentComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Left / top" /><ComboBoxItem Content="Centered" /><ComboBoxItem Content="Right / bottom" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Fine calibration" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock x:Name="HorizontalOffsetText" FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Slider x:Name="HorizontalOffsetSlider" Minimum="-4000" Maximum="4000"
                                                ValueChanged="HorizontalOffsetSlider_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="VerticalOffsetText" FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Slider x:Name="VerticalOffsetSlider" Minimum="-2200" Maximum="2200" Value="8"
                                                ValueChanged="VerticalOffsetSlider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    <Border x:Name="LiquidBorder" IsHitTestVisible="False" CornerRadius="13" BorderThickness="1.5"
            SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <LinearGradientBrush.RelativeTransform>
                    <RotateTransform CenterX="0.5" CenterY="0.5" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF30343A" Offset="0" />
                <GradientStop Color="#FFB9C4CE" Offset="0.16" />
                <GradientStop Color="#FFF7FCFF" Offset="0.23" />
                <GradientStop Color="#FF71818D" Offset="0.33" />
                <GradientStop Color="#FF252A30" Offset="0.52" />
                <GradientStop Color="#FFDAE3EB" Offset="0.72" />
                <GradientStop Color="#FF56616C" Offset="0.85" />
                <GradientStop Color="#FF30343A" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
    </Border>
    </Grid>
</Window>
