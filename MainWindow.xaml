<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DynamicIsland.UI"
        Title="Dynamic Island"
        Icon="pack://application:,,,/Assets/island-logo.png"
        Width="250" Height="8"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
    <Border x:Name="IslandSurface"
            Padding="0"
            Background="Transparent"
            CornerRadius="0,0,15,15"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid x:Name="AtmosphereLayer" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                <Border x:Name="AtmosphereBase" CornerRadius="0,0,15,15">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop x:Name="AtmosphereTopStop" Color="#181D2030" Offset="0" />
                            <GradientStop x:Name="AtmosphereMiddleStop" Color="#780B0C12" Offset="0.48" />
                            <GradientStop x:Name="AtmosphereBottomStop" Color="#D9040508" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="520" Height="240" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,-138,0,0" Opacity="0.18">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop x:Name="AtmosphereAccentStop" Color="#FF6ED6A9" Offset="0" />
                            <GradientStop Color="#006ED6A9" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="340" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-190,-195" Fill="{DynamicResource AccentBrush}" Opacity="0.055" />
                <Border x:Name="AtmosphereVignette" CornerRadius="0,0,15,15">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.22" GradientOrigin="0.5,0.12" RadiusX="0.82" RadiusY="0.9">
                            <GradientStop Color="#00101016" Offset="0.28" />
                            <GradientStop Color="#38000000" Offset="0.72" />
                            <GradientStop Color="#A3000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <Border x:Name="MediaColorWash" CornerRadius="0,0,15,15" Opacity="0"
                    IsHitTestVisible="False" />
            <Grid x:Name="CollapsedContent" Cursor="Hand">
                <Border x:Name="MinimizedHandle" Width="220" Height="2" CornerRadius="1"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                        Background="#38101418" />
                <Border x:Name="FocusTimerMini" Visibility="Collapsed" MinWidth="92" Height="24"
                        Padding="12,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#F00B0C10" CornerRadius="0,0,12,12">
                    <TextBlock x:Name="FocusMiniText" Text="25:00" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel x:Name="ClassicNotchContent" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border x:Name="MiniLogoContainer" Width="16" Height="16" Background="{StaticResource PrimaryActionBrush}" CornerRadius="8">
                        <Grid>
                            <Image x:Name="MiniLogoArtwork" Visibility="Collapsed" Stretch="Uniform" />
                            <Path x:Name="MiniLogoGlyph" Data="{StaticResource NavIconMusic}" Width="10" Height="10"
                                  Fill="Transparent" Stroke="{StaticResource PrimaryActionTextBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="MiniLogoText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="DI" FontSize="7" FontWeight="Bold" Foreground="{StaticResource PrimaryActionTextBrush}" />
                        </Grid>
                    </Border>
                    <Ellipse x:Name="PlaybackIndicator" Width="5" Height="5" Margin="6,0,0,0"
                             Fill="#FF717178" />
                </StackPanel>
            </Grid>

            <Grid x:Name="PreviewContent" Visibility="Collapsed" Opacity="0" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewLogoContainer" Width="36" Height="36" Padding="3" VerticalAlignment="Center"
                        Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="10">
                    <Grid>
                        <Image x:Name="PreviewArtwork" Stretch="Uniform" />
                        <Path x:Name="PreviewLogoGlyph" Data="{StaticResource NavIconMusic}" Width="20" Height="20"
                              Fill="Transparent" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="PreviewFallbackIcon" Text="DI" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewTitle" Text="Dynamic Island" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PreviewArtist" Text="Ready · drag to reposition" Margin="0,2,0,0"
                               FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviewPreviousButton" Style="{StaticResource IslandButton}"
                            Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                            ToolTip="Previous" Click="PreviousButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconPrevious}" Width="13" Height="13" /></Button>
                    <Button x:Name="PreviewPlayPauseButton" Style="{StaticResource IslandButton}"
                            Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                            Background="{StaticResource PrimaryActionBrush}" Foreground="{StaticResource PrimaryActionTextBrush}"
                            ToolTip="Play or pause" Click="PlayPauseButton_Click">
                        <Path x:Name="PreviewPlayPauseIcon" Style="{StaticResource IslandIcon}" Data="{StaticResource IconPlay}" Width="13" Height="13" />
                    </Button>
                    <Button x:Name="PreviewNextButton" Style="{StaticResource IslandButton}"
                            Width="28" Height="28" Padding="0"
                            ToolTip="Next" Click="NextButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconNext}" Width="13" Height="13" /></Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="NotificationContent" Visibility="Collapsed" Opacity="0" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="12" VerticalAlignment="Center"
                        Background="{DynamicResource ControlSurfaceBrush}">
                    <Grid>
                        <Image x:Name="NotificationAppIcon" Width="24" Height="24" Stretch="Uniform" />
                        <Path x:Name="NotificationFallbackIcon" Data="{StaticResource IconBell}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationAppText" Text="NOTIFICATION" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NotificationTitleText" Text="New alert" Margin="0,2,0,0"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NotificationBodyText" Margin="0,2,0,0" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Image Source="pack://application:,,,/Assets/island-logo.png" Width="24" Height="24"
                           Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Stretch="Uniform" ToolTip="Dynamic Island" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="ExpandedNotificationHint" Visibility="Collapsed" MaxWidth="112"
                                   Margin="0,0,9,0" VerticalAlignment="Center" FontSize="10"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}" />
                        <Button Style="{StaticResource ChromeFreeIconButton}" Width="32" Margin="0,0,4,0"
                                ToolTip="Close Dynamic Island" Click="ExitButton_Click"
                                MouseEnter="AnimatedXButton_MouseEnter" MouseLeave="AnimatedXButton_MouseLeave">
                            <ui:AnimatedXIcon Width="17" Height="17" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" PreviewMouseWheel="PanelViewport_PreviewMouseWheel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,7,10,8" Padding="5" CornerRadius="15"
                            Background="#241F2025" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                        <UniformGrid Columns="2" Rows="5" VerticalAlignment="Stretch">
                            <Button x:Name="MediaNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Media" Click="MediaNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconMusic}" /></Button>
                            <Button x:Name="WeatherNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Weather" Click="WeatherNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconWeather}" /></Button>
                            <Button x:Name="HardwareNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="System" Click="HardwareNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconHardware}" /></Button>
                            <Button x:Name="ActivityNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Activity" Click="ActivityNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconActivity}" /></Button>
                            <Button x:Name="ControlsNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Controls" Click="ControlsNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconControls}" /></Button>
                            <Button x:Name="FocusNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Focus" Click="FocusNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconFocus}" /></Button>
                            <Button x:Name="FilesNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Files" Click="FilesNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconFiles}" /></Button>
                            <Button x:Name="ClipboardNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Clipboard" Click="ClipboardNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconClipboard}" /></Button>
                            <Button x:Name="AppsNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Apps" Click="AppsNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconApps}" /></Button>
                            <Button x:Name="SettingsNavButton" Style="{StaticResource IslandNavButton}" Margin="2" ToolTip="Settings" Click="SettingsNavButton_Click"><Path Style="{StaticResource SidebarIcon}" Data="{StaticResource NavIconSettings}" /></Button>
                        </UniformGrid>
                    </Border>

                    <Grid x:Name="PanelViewport" Grid.Column="1" ClipToBounds="True">
                    <Grid x:Name="MediaPanel" Margin="6,8,6,10" VerticalAlignment="Stretch">
                        <Border CornerRadius="28" Background="{DynamicResource PanelSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                        <Image x:Name="MediaBackdropArtwork" Stretch="UniformToFill" Opacity="0"
                               IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Image.Effect><BlurEffect Radius="24" RenderingBias="Performance" /></Image.Effect>
                            <Image.RenderTransform><ScaleTransform ScaleX="1.14" ScaleY="1.14" /></Image.RenderTransform>
                        </Image>
                        <Border x:Name="MediaBackdropVeil" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#B8101116" Offset="0" />
                                    <GradientStop Color="#D9131419" Offset="0.55" />
                                    <GradientStop Color="#F018191D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas x:Name="AudioWaveCanvas" Height="68" VerticalAlignment="Bottom"
                                Margin="18,0,18,10" Opacity="0" IsHitTestVisible="False" />
                        <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="144" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="132" Height="132" VerticalAlignment="Center" Padding="6"
                                Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="22">
                            <Grid>
                                <Border CornerRadius="17" ClipToBounds="True">
                                    <Image x:Name="Artwork" Stretch="UniformToFill" />
                                </Border>
                                <Grid x:Name="ArtworkFallbackIcon" Width="76" Height="76"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush Center="0.32,0.25" GradientOrigin="0.32,0.25" RadiusX="0.76" RadiusY="0.76">
                                                <GradientStop Color="#FFB57CFF" Offset="0" />
                                                <GradientStop Color="#FF7656E8" Offset="0.52" />
                                                <GradientStop Color="#FF3B287D" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect><DropShadowEffect Color="#AA8E62FF" BlurRadius="20" ShadowDepth="0" Opacity="0.72" /></Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Width="55" Height="55" Fill="#1FFFFFFF" Stroke="#32FFFFFF" StrokeThickness="1" />
                                    <Path Data="{StaticResource IconMusic}" Width="31" Height="31" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Fill="White" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                                        <Path Data="{StaticResource IconMusic}" Width="10" Height="10" Stretch="Uniform"
                                              Fill="{DynamicResource PrimaryActionTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="NOW PLAYING" Margin="6,0,0,0" FontSize="9" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <Button x:Name="OpenPlayerButton" Style="{StaticResource IslandButton}"
                                        HorizontalAlignment="Right" Padding="9,5" FontSize="10"
                                        Click="OpenPlayerButton_Click" Content="Open source" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,13,0,0">
                                <TextBlock x:Name="TrackTitle" Text="Nothing playing" FontSize="21" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackArtist" Text="Start music in a supported app" Margin="0,5,0,0"
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AlbumTitle" Margin="0,3,0,0" FontSize="11"
                                           Foreground="#FF717178" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Slider x:Name="SeekSlider" Style="{StaticResource MediaSeekSlider}"
                                        Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="SeekSlider_ValueChanged"
                                        PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                        PreviewKeyUp="SeekSlider_PreviewKeyUp" />
                                <Grid Grid.Row="1" Margin="2,1,2,0">
                                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="DurationText" Text="0:00" FontSize="10" HorizontalAlignment="Right"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button x:Name="PreviousButton" Style="{StaticResource IslandButton}" Width="40" Height="40"
                                        Padding="0" Margin="0,0,10,0" Click="PreviousButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconPrevious}" Width="19" Height="19" /></Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}" Width="46" Height="46"
                                        Padding="0" Margin="0,0,10,0" Background="{StaticResource PrimaryActionBrush}"
                                        Foreground="{StaticResource PrimaryActionTextBrush}"
                                        Click="PlayPauseButton_Click">
                                    <Path x:Name="PlayPauseIcon" Style="{StaticResource IslandIcon}" Data="{StaticResource IconPlay}" Width="21" Height="21" />
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource IslandButton}" Width="40" Height="40"
                                        Padding="0" Click="NextButton_Click"><Path Style="{StaticResource IslandIcon}" Data="{StaticResource IconNext}" Width="19" Height="19" /></Button>
                            </StackPanel>
                            <TextBlock x:Name="MediaStatusText" Grid.Row="4" Margin="0,8,0,0" FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                        </Grid>
                        </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="FilesPanel" Visibility="Collapsed" Margin="8,6,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="File shelf" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IslandButton}" Padding="9,6" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Open persistent file dock folder" Click="OpenFileDockFolderButton_Click">
                                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineButtonIcon}" Data="{StaticResource IconFolderOpen}" /><TextBlock Text="Folder" Margin="6,0,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource IslandButton}" Padding="9,6" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Paste files from the clipboard" Click="PasteFilesButton_Click">
                                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineButtonIcon}" Data="{StaticResource IconPaste}" /><TextBlock Text="Paste" Margin="6,0,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource IslandButton}" Padding="10,6" FontSize="11"
                                        Background="{DynamicResource PrimaryActionBrush}"
                                        Foreground="{DynamicResource PrimaryActionTextBrush}"
                                        Click="AddFilesButton_Click">
                                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineButtonIcon}" Data="{StaticResource IconPlus}" /><TextBlock Text="Add files" Margin="6,0,0,0" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                <TextBlock Text="Your files stay here until you remove them. Drag a row out to use it."
                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FileDockStatus" FontSize="10" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,0,0,9" AllowDrop="True"
                                Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                CornerRadius="14" DragOver="FilesDropZone_DragOver" Drop="FilesDropZone_Drop">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFiles}" Width="17" Height="17" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="Drop files here to keep a copy" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="{DynamicResource PanelSurfaceBrush}" CornerRadius="14" Padding="6">
                            <ListView x:Name="FileList" Background="Transparent" BorderThickness="0"
                                      ItemContainerStyle="{StaticResource FileShelfItem}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="FileList_PreviewMouseMove">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5" Padding="9,6" MinHeight="52"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10"
                                                ToolTip="{Binding FullPath}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="174" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="34" CornerRadius="8" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#334B5563" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".pdf"><Setter Property="Background" Value="#55E85D68" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".doc"><Setter Property="Background" Value="#554A8DFF" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".docx"><Setter Property="Background" Value="#554A8DFF" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".xls"><Setter Property="Background" Value="#554CCB8A" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".xlsx"><Setter Property="Background" Value="#554CCB8A" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".ppt"><Setter Property="Background" Value="#55F28B50" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".pptx"><Setter Property="Background" Value="#55F28B50" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".png"><Setter Property="Background" Value="#558F72E8" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".jpg"><Setter Property="Background" Value="#558F72E8" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Extension}" Value=".jpeg"><Setter Property="Background" Value="#558F72E8" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Path Data="{StaticResource IconDocument}" Width="17" Height="17" Margin="0,-8,0,0"
                                                              Style="{StaticResource LineIcon}" Stroke="{DynamicResource PrimaryTextBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="6.5" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Extension}" FontSize="9"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="  ·  Drag to use" FontSize="9"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IslandButton}" Width="34" Height="29" Padding="0" Margin="0,0,4,0"
                                                            Tag="{Binding FullPath}" ToolTip="Copy to TempVault Inbox" Click="SendToTempVaultButton_Click"><Path Style="{StaticResource LineButtonIcon}" Data="{StaticResource IconVault}" /></Button>
                                                    <Button Style="{StaticResource IslandButton}" Width="34" Height="29" Padding="0" Margin="0,0,4,0"
                                                            Tag="{Binding FullPath}" ToolTip="Open file" Click="OpenFileButton_Click"><Path Style="{StaticResource LineButtonIcon}" Data="{StaticResource IconExternal}" /></Button>
                                                    <Button Style="{StaticResource IslandButton}" Width="34" Height="29" Padding="0" Margin="0,0,4,0"
                                                            Tag="{Binding FullPath}" ToolTip="Copy file" Click="CopyFileButton_Click"><Path Style="{StaticResource LineButtonIcon}" Data="{StaticResource IconCopy}" /></Button>
                                                    <Button Style="{StaticResource ChromeFreeIconButton}" Width="28" Height="29"
                                                            Tag="{Binding FullPath}"
                                                            ToolTip="Remove stored copy" Click="RemoveFileButton_Click"
                                                            MouseEnter="AnimatedXButton_MouseEnter" MouseLeave="AnimatedXButton_MouseLeave">
                                                        <ui:AnimatedXIcon Width="15" Height="15" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=FileList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource IconFiles}" Width="23" Height="23"
                                  Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No saved files yet" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" TextAlignment="Center" Margin="0,9,0,0" />
                            <TextBlock Text="Drop a file above or choose Add files."
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ClipboardPanel" Visibility="Collapsed" Margin="4,4,4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Clipboard" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Paste and copy text, images, and files from the Windows clipboard." FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,12">
                            <TextBox x:Name="ClipboardTextBox" Padding="12"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource InputSurfaceBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                                     BorderThickness="0" />
                            <Border x:Name="ClipboardImagePanel" Visibility="Collapsed" Padding="12"
                                    Background="{StaticResource InputSurfaceBrush}" CornerRadius="10">
                                <Image x:Name="ClipboardImagePreview" Stretch="Uniform" />
                            </Border>
                            <Border x:Name="ClipboardFilesPanel" Visibility="Collapsed" Padding="12"
                                    Background="{StaticResource InputSurfaceBrush}" CornerRadius="10">
                                <ListBox x:Name="ClipboardFilesList" BorderThickness="0" Background="Transparent"
                                         Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock x:Name="ClipboardStatus" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                        Click="EditClipboardTextButton_Click" Content="Edit text" />
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                        Click="PasteTextButton_Click" Content="Paste" />
                                <Button Style="{StaticResource IslandButton}" Background="{StaticResource PrimaryActionBrush}"
                                        Foreground="{StaticResource PrimaryActionTextBrush}"
                                        Click="CopyTextButton_Click" Content="Copy" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AppsPanel" Visibility="Collapsed" Margin="4,4,4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="App runner" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Keep an app beside your work. Standard windows are interactive; some packaged apps show a view-only live preview."
                                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>

                        <Border x:Name="AppHostViewport" Grid.Row="1"
                                Background="{DynamicResource HostSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                CornerRadius="16" ClipToBounds="True">
                            <Grid>
                                <StackPanel x:Name="AppHostPlaceholder" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" MaxWidth="290">
                                    <Path Data="{StaticResource IconApps}" Width="28" Height="28"
                                          Stretch="Uniform" Fill="{DynamicResource SecondaryTextBrush}"
                                          HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <TextBlock Text="Your workspace, inside the island" FontSize="13"
                                               FontWeight="SemiBold" TextAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Choose a saved, running, or installed app to begin."
                                               Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                                               TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8"
                                Background="{DynamicResource PanelSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="SAVED" Margin="2,0,0,4" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ListBox x:Name="AppList" Grid.Row="1" Height="28" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource PrimaryTextBrush}" ItemContainerStyle="{StaticResource AppRunnerCompactListItem}"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Style="{StaticResource AppRunnerCompactButton}" Margin="0,0,5,0" Click="AddAppButton_Click" Content="Add" />
                                        <Button Style="{StaticResource AppRunnerCompactButton}" Margin="0,0,5,0" Click="RemoveAppButton_Click" Content="Remove" />
                                        <Button Style="{StaticResource AppRunnerCompactPrimaryButton}" Click="UseAppInPanelButton_Click" Content="Open" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="RUNNING WINDOWS" Margin="2,0,0,4" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="RunningAppsComboBox" Grid.Row="1" Height="28" FontSize="10" MaxDropDownHeight="180">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Style="{StaticResource AppRunnerCompactButton}" Margin="0,0,5,0" Click="RefreshRunningAppsButton_Click" Content="Refresh" />
                                        <Button Style="{StaticResource AppRunnerCompactPrimaryButton}" Click="UseRunningAppButton_Click" Content="Attach" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="INSTALLED APPS" Margin="2,0,0,4" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="InstalledAppsComboBox" Grid.Row="1" Height="28" FontSize="10" MaxDropDownHeight="200">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Style="{StaticResource AppRunnerCompactButton}" Margin="0,0,5,0" Click="RefreshInstalledAppsButton_Click" Content="Refresh" />
                                        <Button Style="{StaticResource AppRunnerCompactPrimaryButton}" Click="RunInstalledAppButton_Click" Content="Open" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,7,0,0">
                            <TextBlock x:Name="AppRunnerStatus" Margin="0,0,285,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,32,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AppResizeSizeText" Text="920 × 600" Margin="0,0,10,0"
                                           FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <Button x:Name="DetachAppButton" Style="{StaticResource AppRunnerCompactButton}"
                                        Click="DetachAppButton_Click" Content="Release window"
                                        ToolTip="Return the hosted window to its original desktop position" />
                            </StackPanel>
                            <Thumb x:Name="AppResizeThumb" Width="26" Height="26" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Cursor="SizeNWSE" ToolTip="Drag to resize the Apps workspace"
                                   DragStarted="AppResizeThumb_DragStarted" DragDelta="AppResizeThumb_DragDelta"
                                   DragCompleted="AppResizeThumb_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ResizeSurface" Background="Transparent" CornerRadius="7">
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="16" Height="16">
                                                    <Path Data="M7,15 L15,7 M11,15 L15,11 M3,15 L15,3"
                                                          Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ResizeSurface" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ResizeSurface" Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>

                    <Grid x:Name="WeatherPanel" Visibility="Collapsed">
                        <StackPanel Margin="4,5,8,8">
                            <Grid Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="Weather" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="A glance at conditions where you are."
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button x:Name="WeatherRefreshButton" Style="{StaticResource IslandButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="11,6"
                                        Click="WeatherRefreshButton_Click" Content="Refresh" />
                            </Grid>

                            <Border Padding="14" CornerRadius="18" Background="{DynamicResource PanelSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="WeatherLocationText" Text="Weather unavailable" FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock x:Name="WeatherTemperatureText" Text="--°" Margin="0,3,0,0"
                                                   FontSize="38" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="WeatherConditionText" Text="Choose refresh to load current conditions"
                                                   FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="88" Height="76" VerticalAlignment="Center" Margin="16,0,2,0">
                                        <Ellipse Width="70" Height="70" Fill="#28FDBA4A" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Effect><BlurEffect Radius="18" /></Ellipse.Effect>
                                        </Ellipse>
                                        <Viewbox Width="78" Height="72" Stretch="Uniform">
                                            <Canvas Width="96" Height="92">
                                                <Ellipse x:Name="WeatherSun" Canvas.Left="13" Canvas.Top="5" Width="38" Height="38" Fill="#FFFFC857">
                                                    <Ellipse.Effect><DropShadowEffect Color="#FFFFB52E" BlurRadius="14" ShadowDepth="0" Opacity="0.72" /></Ellipse.Effect>
                                                </Ellipse>
                                                <Path x:Name="WeatherSunRays" Data="M32,0 L32,7 M32,42 L32,49 M7,24 L14,24 M50,24 L57,24 M14,7 L19,12 M45,36 L50,41 M50,7 L45,12 M19,36 L14,41"
                                                      Stroke="#FFFFD873" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Path x:Name="WeatherCloud" Stroke="#66FFFFFF" StrokeThickness="1.25">
                                                    <Path.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFF4F8FF" Offset="0" />
                                                            <GradientStop Color="#FFADC5E3" Offset="0.55" />
                                                            <GradientStop Color="#FF728EBA" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Path.Fill>
                                                    <Path.Data>M20,65 C10,65 7,53 14,47 C17,44 21,43 25,44 C27,33 36,27 46,30 C52,21 68,25 69,39 C79,40 86,47 84,57 C83,64 76,68 67,68 L22,68 C21,68 20,67 20,65 Z</Path.Data>
                                                    <Path.Effect><DropShadowEffect Color="#AA4B68A0" BlurRadius="10" ShadowDepth="3" Opacity="0.7" /></Path.Effect>
                                                </Path>
                                                <Path x:Name="WeatherRain" Data="M29,75 L24,84 M49,75 L44,84 M69,75 L64,84"
                                                      Stroke="#FF55C7FF" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Path x:Name="WeatherSnow" Visibility="Collapsed" Data="M26,78 L26,88 M21,83 L31,83 M46,78 L46,88 M41,83 L51,83 M66,78 L66,88 M61,83 L71,83"
                                                      Stroke="#FFE6F7FF" StrokeThickness="2.5" StrokeStartLineCap="Round" />
                                                <Path x:Name="WeatherThunder" Visibility="Collapsed" Data="M52,70 L42,82 L50,82 L44,92 L62,77 L54,77 Z"
                                                      Fill="#FFFFD84A" Stroke="#FFFFE889" StrokeThickness="1" />
                                                <Path x:Name="WeatherFog" Visibility="Collapsed" Data="M18,76 L76,76 M24,84 L69,84 M33,91 L62,91"
                                                      Stroke="#FFB6C7D9" StrokeThickness="3" StrokeStartLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,7,0,0">
                                <Border Margin="0,0,5,0" Padding="9" CornerRadius="12" Background="{DynamicResource PanelSurfaceBrush}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource IconThermometer}" Width="12" Height="12" Stroke="{DynamicResource AccentBrush}" /><TextBlock Text="FEELS LIKE" Margin="5,0,0,0" FontSize="8" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="WeatherFeelsText" Text="--°" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /></StackPanel>
                                </Border>
                                <Border Margin="2,0" Padding="9" CornerRadius="12" Background="{DynamicResource PanelSurfaceBrush}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource IconDroplet}" Width="12" Height="12" Stroke="{DynamicResource AccentBrush}" /><TextBlock Text="HUMIDITY" Margin="5,0,0,0" FontSize="8" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="WeatherHumidityText" Text="--%" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /></StackPanel>
                                </Border>
                                <Border Margin="5,0,0,0" Padding="9" CornerRadius="12" Background="{DynamicResource PanelSurfaceBrush}">
                                    <StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWind}" Width="12" Height="12" Stroke="{DynamicResource AccentBrush}" /><TextBlock Text="WIND" Margin="5,0,0,0" FontSize="8" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="WeatherWindText" Text="--" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Margin="0,7,0,0" Padding="10" CornerRadius="12" Background="{DynamicResource PanelSurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Location" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBox x:Name="WeatherLocationTextBox" Grid.Column="1" Margin="14,0,0,0" Padding="10,6"
                                             Background="{DynamicResource PanelSurfaceBrush}"
                                             ToolTip="Leave blank to use approximate IP location" Text="" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="WeatherStatusText" Margin="2,5,2,0" FontSize="9" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Weather loads only when you open this dashboard. Leave location blank for approximate IP location." />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="HardwarePanel" Visibility="Collapsed">
                        <StackPanel Margin="4,5,8,8">
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="System pulse" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Live device load without leaving the notch."
                                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HardwareUpdatedText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                            <UniformGrid Columns="3" Rows="2">
                                <Border Margin="0,0,5,6" Padding="11" CornerRadius="15" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel><TextBlock Text="CPU" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock x:Name="CpuValueText" Text="--%" Margin="0,5,0,6" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><ProgressBar x:Name="CpuProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" /></StackPanel>
                                </Border>
                                <Border Margin="3,0,3,6" Padding="11" CornerRadius="15" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel><TextBlock Text="MEMORY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock x:Name="MemoryValueText" Text="--%" Margin="0,5,0,6" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><ProgressBar x:Name="MemoryProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" /><TextBlock x:Name="MemoryDetailText" Margin="0,4,0,0" FontSize="8" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                </Border>
                                <Border Margin="5,0,0,6" Padding="11" CornerRadius="15" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel><TextBlock Text="STORAGE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock x:Name="StorageValueText" Text="--%" Margin="0,5,0,6" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><ProgressBar x:Name="StorageProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" /><TextBlock x:Name="StorageDetailText" Margin="0,4,0,0" FontSize="8" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                </Border>
                                <Border Margin="0,3,5,0" Padding="11" CornerRadius="15" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel><TextBlock Text="POWER" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock x:Name="BatteryValueText" Text="--" Margin="0,5,0,6" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><ProgressBar x:Name="BatteryProgress" Style="{StaticResource MetricProgressBar}" Maximum="100" /><TextBlock x:Name="BatteryDetailText" Margin="0,4,0,0" FontSize="8" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                </Border>
                                <Border Margin="3,3,3,0" Padding="11" CornerRadius="15" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel><TextBlock Text="NETWORK" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock x:Name="NetworkValueText" Text="↓ -- Mbps" Margin="0,6,0,4" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><TextBlock x:Name="NetworkDetailText" Text="↑ -- Mbps" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                </Border>
                                <Border Margin="5,3,0,0" Padding="11" CornerRadius="15" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel><TextBlock Text="GPU / TEMP" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Sensors" Margin="0,6,0,4" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" /><TextBlock Text="When exposed by Windows" FontSize="8" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ActivityPanel" Visibility="Collapsed">
                        <StackPanel Margin="4,5,8,8">
                            <TextBlock Text="Activity stack" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Music, focus sessions, and background work in one place." Margin="0,1,0,9"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Border Padding="11" Margin="0,0,0,7" CornerRadius="14" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource NavIconMusic}" Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"/>
                                    <StackPanel Grid.Column="1"><TextBlock x:Name="ActivityMusicTitle" Text="Music" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="ActivityMusicDetail" Text="Nothing playing" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/><ProgressBar x:Name="ActivityMusicProgress" Margin="0,7,16,0" Height="3" Style="{StaticResource MetricProgressBar}" Maximum="100"/></StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource ChromeFreeIconButton}" Width="30" Height="30" ToolTip="Open media" Click="ActivityMusicButton_Click"><TextBlock Text="›" FontSize="22"/></Button>
                                </Grid>
                            </Border>
                            <Border Padding="11" Margin="0,0,0,7" CornerRadius="14" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource NavIconFocus}" Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Focus session" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="ActivityFocusDetail" Text="Ready · 25 minutes" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/><ProgressBar x:Name="ActivityFocusProgress" Margin="0,7,16,0" Height="3" Style="{StaticResource MetricProgressBar}" Maximum="100"/></StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource ChromeFreeIconButton}" Width="30" Height="30" ToolTip="Open focus timer" Click="ActivityFocusButton_Click"><TextBlock Text="›" FontSize="22"/></Button>
                                </Grid>
                            </Border>
                            <Border Padding="11" CornerRadius="14" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource NavIconFiles}" Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="File shelf" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="ActivityFilesDetail" Text="No active transfers" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/><ProgressBar x:Name="ActivityFilesProgress" Visibility="Collapsed" Margin="0,7,0,0" Height="3" Style="{StaticResource MetricProgressBar}" Maximum="100"/></StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ControlsPanel" Visibility="Collapsed">
                        <StackPanel Margin="4,5,8,8">
                            <Grid Margin="0,0,0,9"><StackPanel><TextBlock Text="Control Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="Fast Windows controls without leaving the notch." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><Path Data="{StaticResource NavIconControls}" Width="18" Height="18" HorizontalAlignment="Right" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.6"/></Grid>
                            <UniformGrid Columns="3" Rows="2">
                                <Button Style="{StaticResource IslandButton}" Margin="0,0,5,5" Height="56" Click="AudioSettingsButton_Click"><StackPanel><Path Data="{StaticResource IconVolume}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}"/><TextBlock Text="Audio" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                <Button x:Name="MicControlButton" Style="{StaticResource IslandButton}" Margin="3,0,3,5" Height="56" Click="MicControlButton_Click"><StackPanel><Path Data="{StaticResource IconMic}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}"/><TextBlock x:Name="MicControlText" Text="Mic" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource IslandButton}" Margin="5,0,0,5" Height="56" Click="NetworkSettingsButton_Click"><StackPanel><Path Data="{StaticResource IconNetwork}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}"/><TextBlock Text="Network" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource IslandButton}" Margin="0,3,5,0" Height="56" Click="DisplaySettingsButton_Click"><StackPanel><Path Data="{StaticResource IconDisplay}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}"/><TextBlock Text="Display" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource IslandButton}" Margin="3,3,3,0" Height="56" Click="BluetoothSettingsButton_Click"><StackPanel><Path Data="{StaticResource IconBluetooth}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}"/><TextBlock Text="Bluetooth" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource IslandButton}" Margin="5,3,0,0" Height="56" Click="FocusAssistSettingsButton_Click"><StackPanel><Path Data="{StaticResource IconMoon}" Style="{StaticResource LineIcon}" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}"/><TextBlock Text="Focus" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                            </UniformGrid>
                            <Border Margin="0,8,0,0" Padding="11" CornerRadius="13" Background="{DynamicResource PanelSurfaceBrush}">
                                <StackPanel><Grid><TextBlock Text="Output volume" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="VolumeValueText" Text="--%" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="VolumeSlider" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100" Margin="0,8,0,0" ValueChanged="VolumeSlider_ValueChanged"/></StackPanel>
                            </Border>
                            <Grid Margin="0,8,0,0"><TextBlock Text="SYSTEM LOAD" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock x:Name="ControlsSystemLoadText" Text="CPU --% · RAM --%" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/></Grid>
                            <Button Style="{StaticResource IslandButton}" Margin="0,8,0,0" Padding="10,6" HorizontalAlignment="Left" Click="ScreenCaptureButton_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCamera}" Style="{StaticResource LineButtonIcon}"/><TextBlock Text="Screen capture" Margin="7,0,0,0"/></StackPanel></Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FocusPanel" Visibility="Collapsed">
                        <StackPanel Margin="4,5,8,8">
                            <TextBlock Text="Focus timer" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="A quiet timer that stays available from the top edge." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Border Margin="0,10,0,9" Padding="15" CornerRadius="20" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <StackPanel><TextBlock x:Name="FocusTimerText" Text="25:00" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="FocusTimerStateText" Text="Ready to focus" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><ProgressBar x:Name="FocusProgress" Height="5" Margin="14,11,14,0" Style="{StaticResource MetricProgressBar}" Maximum="100"/></StackPanel>
                            </Border>
                            <UniformGrid Columns="3"><Button Style="{StaticResource IslandButton}" Tag="25" Margin="0,0,5,0" Padding="10,8" Click="FocusPresetButton_Click" Content="25 min"/><Button Style="{StaticResource IslandButton}" Tag="5" Margin="3,0" Padding="10,8" Click="FocusPresetButton_Click" Content="5 min"/><Button Style="{StaticResource IslandButton}" Tag="15" Margin="5,0,0,0" Padding="10,8" Click="FocusPresetButton_Click" Content="15 min"/></UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0"><Button x:Name="FocusStartButton" Style="{StaticResource AppRunnerPrimaryButton}" Margin="0,0,8,0" Click="FocusStartButton_Click" Content="Start"/><Button Style="{StaticResource IslandButton}" Click="FocusResetButton_Click" Content="Reset"/></StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <StackPanel Margin="4,4,8,8">
                            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="SettingsSaveStatusText" Text="Changes are saved automatically."
                                       FontSize="11" Margin="0,0,0,9" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />

                            <Border Padding="11" Margin="0,0,0,7" Background="{DynamicResource PanelSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Island Control Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="ControlCenterStatusText" Text="Configure position, colors, opacity, and TempVault in the separate Windows app."
                                                   FontSize="11" TextWrapping="Wrap" MaxWidth="390"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <Button x:Name="OpenControlCenterButton" Grid.Column="1" Style="{StaticResource AppRunnerPrimaryButton}"
                                            VerticalAlignment="Center" Margin="12,0,0,0"
                                            Click="OpenSettingsAppButton_Click" Content="Open control center" />
                                </Grid>
                            </Border>

                            <Border Padding="11" Margin="0,0,0,7" Background="{DynamicResource PanelSurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Windows notifications" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Show new alerts as a brief drop-down from the notch. Access is optional and notification text is not saved."
                                                   MaxWidth="370" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="NotificationPermissionStatus" Margin="0,5,0,0"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="EnableNotificationsButton" Style="{StaticResource AppRunnerPrimaryButton}" Margin="0,0,0,6"
                                                Click="EnableNotificationsButton_Click" Content="Enable alerts" />
                                        <Button Style="{StaticResource AppRunnerActionButton}"
                                                Click="TestNotificationButton_Click" Content="Test animation" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Legacy controls remain instantiated for existing bindings and
                                 configuration migration; their live editing now lives in the companion. -->
                            <StackPanel x:Name="LegacyAppearanceControls" Visibility="Collapsed">
                            <Border Padding="11" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Island opacity" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="The per-pixel transparent surface." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="OpacityValueText" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Slider x:Name="OpacitySlider" Style="{StaticResource BeUiOpacitySlider}" Minimum="10" Maximum="100" Value="42"
                                                ValueChanged="OpacitySlider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Appearance" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Switch between dark and light island surfaces." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1"
                                              SelectionChanged="ThemeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Dark" />
                                        <ComboBoxItem Content="Light" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Island surface" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Use the theme color or your own two-color gradient."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ComboBox x:Name="SurfaceStyleComboBox"
                                                  SelectionChanged="SurfaceStyleComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Solid theme color" />
                                            <ComboBoxItem Content="Custom gradient" />
                                        </ComboBox>
                                        <StackPanel x:Name="BackgroundColorOptions" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBox x:Name="BackgroundColorTextBox" Width="130" Height="30"
                                                     VerticalContentAlignment="Center" />
                                            <Button Style="{StaticResource IslandButton}" Margin="8,0,0,0"
                                                    Click="PickBackgroundColorButton_Click" Content="Pick" />
                                            <Button Style="{StaticResource IslandButton}" Margin="6,0,0,0"
                                                    Click="ApplyBackgroundColorButton_Click" Content="Apply" />
                                        </StackPanel>
                                        <StackPanel x:Name="GradientOptions" Margin="0,8,0,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBox x:Name="GradientStartColorTextBox" Width="130" Height="28" Padding="7,3"
                                                         VerticalContentAlignment="Center" Background="{StaticResource InputSurfaceBrush}"
                                                         Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0" />
                                                <Button Style="{StaticResource IslandButton}" Tag="Start" Margin="8,0,0,0"
                                                        Click="PickGradientColorButton_Click" Content="Pick start" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBox x:Name="GradientEndColorTextBox" Width="130" Height="28" Padding="7,3"
                                                         VerticalContentAlignment="Center" Background="{StaticResource InputSurfaceBrush}"
                                                         Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0" />
                                                <Button Style="{StaticResource IslandButton}" Tag="End" Margin="8,0,0,0"
                                                        Click="PickGradientColorButton_Click" Content="Pick end" />
                                            </StackPanel>
                                            <ComboBox x:Name="GradientDirectionComboBox"
                                                      SelectionChanged="GradientDirectionComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Top to bottom" />
                                                <ComboBoxItem Content="Left to right" />
                                                <ComboBoxItem Content="Diagonal" />
                                            </ComboBox>
                                            <Button Style="{StaticResource IslandButton}" Margin="0,7,0,0"
                                                    HorizontalAlignment="Left" Click="ApplyGradientButton_Click" Content="Apply colors" />
                                            <TextBlock x:Name="GradientStatusText" Margin="0,5,0,0" FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Accent color" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Use a hex color or choose a preset." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="AccentStatusText" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border x:Name="AccentPreview" Width="28" Height="28" Margin="0,0,8,0"
                                                    Background="{DynamicResource AccentBrush}" CornerRadius="8" />
                                            <TextBox x:Name="AccentColorTextBox" Width="104" Height="28" Padding="7,3"
                                                     VerticalContentAlignment="Center" Background="{StaticResource InputSurfaceBrush}"
                                                     Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0" />
                                            <Button Style="{StaticResource IslandButton}" Margin="8,0,0,0" Padding="9,4"
                                                    Click="PickAccentButton_Click" Content="Pick" />
                                            <Button Style="{StaticResource IslandButton}" Margin="8,0,0,0" Padding="10,4"
                                                    Click="ApplyAccentButton_Click" Content="Apply" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IslandButton}" Tag="#6ED6A9" Padding="8,3" Margin="0,0,5,0"
                                                    Click="AccentPresetButton_Click" Content="Mint" />
                                            <Button Style="{StaticResource IslandButton}" Tag="#66A3FF" Padding="8,3" Margin="0,0,5,0"
                                                    Click="AccentPresetButton_Click" Content="Blue" />
                                            <Button Style="{StaticResource IslandButton}" Tag="#B68CFF" Padding="8,3" Margin="0,0,5,0"
                                                    Click="AccentPresetButton_Click" Content="Purple" />
                                            <Button Style="{StaticResource IslandButton}" Tag="#FF9A62" Padding="8,3"
                                                    Click="AccentPresetButton_Click" Content="Orange" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Island logo" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Choose what appears in the mini and hover states." FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LogoStyleComboBox" Grid.Column="1"
                                              SelectionChanged="LogoStyleComboBox_SelectionChanged">
                                        <ComboBoxItem Content="DI monogram" />
                                        <ComboBoxItem Content="Music note" />
                                        <ComboBoxItem Content="Minimal dot" />
                                        <ComboBoxItem Content="Album artwork" />
                                        <ComboBoxItem Content="Island mark" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            </StackPanel>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Custom mini logo" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Crop and rotate a picture for the minimized island. A copy is saved locally."
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IslandButton}" Margin="0,0,8,0"
                                                    Click="ChooseMiniLogoButton_Click" Content="Choose picture" />
                                            <Button Style="{StaticResource IslandButton}"
                                                    Click="ClearMiniLogoButton_Click" Content="Clear" />
                                        </StackPanel>
                                        <TextBlock x:Name="MiniLogoStatusText" Margin="0,6,0,0" FontSize="10" TextAlignment="Right"
                                                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="LegacyPositionControls" Visibility="Collapsed">
                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Dock position" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <Button Style="{StaticResource IslandButton}" Margin="0,8,20,0"
                                                Click="ResetPositionButton_Click" Content="Reset position" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="Edge" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="EdgeComboBox" SelectionChanged="EdgeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Top" /><ComboBoxItem Content="Left" /><ComboBoxItem Content="Right" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Alignment" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="AlignmentComboBox" SelectionChanged="AlignmentComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Left / top" /><ComboBoxItem Content="Centered" /><ComboBoxItem Content="Right / bottom" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="14" Background="{StaticResource PanelSurfaceBrush}" CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Fine calibration" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock x:Name="HorizontalOffsetText" FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Slider x:Name="HorizontalOffsetSlider" Style="{StaticResource IslandSlider}" Minimum="-4000" Maximum="4000"
                                                ValueChanged="HorizontalOffsetSlider_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="VerticalOffsetText" FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <Slider x:Name="VerticalOffsetSlider" Style="{StaticResource IslandSlider}" Minimum="-2200" Maximum="2200" Value="0"
                                                ValueChanged="VerticalOffsetSlider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    <Border x:Name="LiquidBorder" IsHitTestVisible="False" CornerRadius="0,0,15,15" BorderThickness="1.5"
            SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <LinearGradientBrush.RelativeTransform>
                    <RotateTransform CenterX="0.5" CenterY="0.5" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#FF30343A" Offset="0" />
                <GradientStop Color="#FFB9C4CE" Offset="0.16" />
                <GradientStop Color="#FFF7FCFF" Offset="0.23" />
                <GradientStop Color="#FF71818D" Offset="0.33" />
                <GradientStop Color="#FF252A30" Offset="0.52" />
                <GradientStop Color="#FFDAE3EB" Offset="0.72" />
                <GradientStop Color="#FF56616C" Offset="0.85" />
                <GradientStop Color="#FF30343A" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
    </Border>
    </Grid>
</Window>
