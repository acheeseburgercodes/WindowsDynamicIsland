<Application
    x:Class="DynamicIsland.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="IslandSurfaceColor">#A6111113</Color>
            <SolidColorBrush x:Key="IslandSurfaceBrush" Color="{StaticResource IslandSurfaceColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF7F7F8" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA5A5AA" />
            <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#E629292E" />
            <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#8029292E" />
            <SolidColorBrush x:Key="InputSurfaceBrush" Color="#B329292E" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#D629292E" />
            <SolidColorBrush x:Key="DropSurfaceBrush" Color="#402F2F35" />
            <SolidColorBrush x:Key="DividerBrush" Color="#665B5B63" />
            <SolidColorBrush x:Key="HostSurfaceBrush" Color="#FF09090B" />
            <SolidColorBrush x:Key="PrimaryActionBrush" Color="#FFF4F4F5" />
            <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FF111113" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF6ED6A9" />

            <!-- Filled, resolution-independent icons; they remain sharp at every island size. -->
            <Geometry x:Key="IconMusic">M9,3 L18,1 18,14 C18,16 16,17 14,17 C12,17 10.5,15.8 10.5,14.2 C10.5,12.5 12,11.5 14,11.5 C14.7,11.5 15.4,11.6 16,12 L16,5 11,6.2 11,16 C11,18 9,19 7,19 C5,19 3.5,17.8 3.5,16.2 C3.5,14.5 5,13.5 7,13.5 C7.7,13.5 8.4,13.6 9,14 Z</Geometry>
            <Geometry x:Key="IconBell">M12,2 C8.7,2 6,4.7 6,8 L6,13.2 3.8,16 3.8,17.5 20.2,17.5 20.2,16 18,13.2 18,8 C18,4.7 15.3,2 12,2 Z M9.5,19 C9.8,20.6 10.6,21.5 12,21.5 13.4,21.5 14.2,20.6 14.5,19 Z</Geometry>
            <Geometry x:Key="IconFiles">M3,3 L10,3 12,5 21,5 21,19 3,19 Z M5,8 L19,8 19,17 5,17 Z M7,11 L17,11 17,12 7,12 Z M7,14 L14,14 14,15 7,15 Z</Geometry>
            <Geometry x:Key="IconClipboard">M8,2 L16,2 16,4 19,4 19,21 5,21 5,4 8,4 Z M10,4 L10,6 14,6 14,4 Z M7,8 L7,19 17,19 17,8 Z M9,11 L15,11 15,12 9,12 Z M9,14 L15,14 15,15 9,15 Z</Geometry>
            <Geometry x:Key="IconApps">M3,3 L10,3 10,10 3,10 Z M14,3 L21,3 21,10 14,10 Z M3,14 L10,14 10,21 3,21 Z M14,14 L21,14 21,21 14,21 Z</Geometry>
            <Geometry x:Key="IconSettings">M10,2 L14,2 14.6,4.2 16.2,4.9 18.2,3.8 20.8,6.4 19.7,8.4 20.4,10 22.5,10.6 22.5,14 20.4,14.6 19.7,16.2 20.8,18.2 18.2,20.8 16.2,19.7 14.6,20.4 14,22.5 10,22.5 9.4,20.4 7.8,19.7 5.8,20.8 3.2,18.2 4.3,16.2 3.6,14.6 1.5,14 1.5,10.6 3.6,10 4.3,8.4 3.2,6.4 5.8,3.8 7.8,4.9 9.4,4.2 Z M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z</Geometry>
            <Geometry x:Key="IconPrevious">M5,5 L7,5 7,19 5,19 Z M18,5 L18,19 8,12 Z</Geometry>
            <Geometry x:Key="IconNext">M17,5 L19,5 19,19 17,19 Z M6,5 L16,12 6,19 Z</Geometry>
            <Geometry x:Key="IconPlay">M8,4.5 C8,3.7 8.9,3.25 9.6,3.7 L20,10.65 C21,11.3 21,12.7 20,13.35 L9.6,20.3 C8.9,20.75 8,20.3 8,19.5 Z</Geometry>
            <Geometry x:Key="IconPause">M6,4 L10,4 10,20 6,20 Z M14,4 L18,4 18,20 14,20 Z</Geometry>
            <Geometry x:Key="IconExpand">M8,4 L4,4 4,8 M4,4 L10,10 M16,4 L20,4 20,8 M20,4 L14,10 M8,20 L4,20 4,16 M4,20 L10,14 M16,20 L20,20 20,16 M20,20 L14,14</Geometry>
            <Geometry x:Key="IconClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</Geometry>
            <Geometry x:Key="IconCollapse">M4,10 L10,10 10,4 M10,10 L4,4 M20,10 L14,10 14,4 M14,10 L20,4 M4,14 L10,14 10,20 M10,14 L4,20 M20,14 L14,14 14,20 M14,14 L20,20</Geometry>
            <Style x:Key="IslandIcon" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="IslandButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ButtonFrame" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="11" />
                                <Border x:Name="HoverGlass" CornerRadius="11" Opacity="0"
                                        BorderThickness="1" BorderBrush="#30FFFFFF"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                            <GradientStop Color="#32FFFFFF" Offset="0" />
                                            <GradientStop Color="#14FFFFFF" Offset="0.42" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonFrame"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="-1" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="HoverGlass"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonFrame"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="HoverGlass"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.78" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.4" />
                                    <Setter TargetName="HoverGlass" Property="Opacity" Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppRunnerActionButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="IslandNavButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="9,6" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AppRunnerPrimaryButton" TargetType="Button" BasedOn="{StaticResource AppRunnerActionButton}">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="FileShelfItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppRunnerListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Padding" Value="9,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="9"
                                    BorderBrush="Transparent" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                    <Setter TargetName="ItemFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FluidComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="3,2">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource FluidComboBoxItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="ControlFrame" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12" />
                                <ContentPresenter Margin="12,0,33,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False" />
                                <Path x:Name="Chevron" Data="M4,8 L12,16 20,8" Width="12" Height="12"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Margin="0,0,11,0">
                                    <Path.RenderTransform><RotateTransform CenterX="6" CenterY="6" /></Path.RenderTransform>
                                </Path>
                                <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" CornerRadius="12" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=ControlFrame}"
                                       AllowsTransparency="True" PopupAnimation="Fade" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border x:Name="PopupFrame" MinWidth="{Binding ActualWidth, ElementName=ControlFrame}"
                                            Margin="0,4,0,0" Padding="4" CornerRadius="14"
                                            Background="{DynamicResource HostSurfaceBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                        <Border.RenderTransform>
                                            <ScaleTransform CenterX="0.5" CenterY="0" />
                                        </Border.RenderTransform>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                      CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ControlFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="ControlFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                        <Setter.Value><RotateTransform Angle="180" CenterX="6" CenterY="6" /></Setter.Value>
                                    </Setter>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PopupFrame"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.94" To="1" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ControlFrame" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaSeekSlider" TargetType="Slider">
                <Setter Property="Height" Value="30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="{TemplateBinding Height}">
                                <Track x:Name="PART_Track" Margin="7,0" VerticalAlignment="Center"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentBrush}" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="14" Height="14" Fill="{DynamicResource PrimaryActionBrush}"
                                                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{DynamicResource DividerBrush}" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PART_Track" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IslandSlider" TargetType="Slider" BasedOn="{StaticResource MediaSeekSlider}">
                <Setter Property="Height" Value="28" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="BeUiOpacitySlider" TargetType="Slider" BasedOn="{StaticResource IslandSlider}" />

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Width="8" Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="24" Margin="2,0" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Grip" Background="{DynamicResource DividerBrush}" CornerRadius="3" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Height="8" Background="Transparent">
                                        <Track x:Name="PART_Track" Orientation="Horizontal"
                                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb MinWidth="24" Margin="0,2" Cursor="Hand">
                                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource DividerBrush}" CornerRadius="3" /></ControlTemplate></Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
