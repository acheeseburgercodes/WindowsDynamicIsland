            <Geometry x:Key="IconExternal">M14,4 L20,4 L20,10 M20,4 L11,13 M18,13 L18,20 L4,20 L4,6 L11,6</Geometry>
            <Geometry x:Key="IconCopy">M8,8 L21,8 L21,21 L8,21 Z M8,17 L3,17 L3,3 L17,3 L17,8</Geometry>
