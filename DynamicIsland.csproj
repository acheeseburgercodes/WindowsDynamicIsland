<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>DynamicIsland</RootNamespace>
    <Version>0.1.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\island-logo.png" />
  </ItemGroup>

  <Target Name="SignBuiltExecutable" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(CodeSigningCertificateThumbprint)' != '' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)\tools\Sign-Executable.ps1&quot; -FilePath &quot;$(TargetDir)$(AssemblyName).exe&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />
  </Target>

  <Target Name="SignPublishedExecutable" AfterTargets="Publish"
          Condition="'$(CodeSigningCertificateThumbprint)' != '' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)\tools\Sign-Executable.ps1&quot; -FilePath &quot;$(PublishDir)$(AssemblyName).exe&quot; -CertificateThumbprint &quot;$(CodeSigningCertificateThumbprint)&quot;" />
  </Target>

</Project>
